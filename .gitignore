# === Oikos: instance is the entire private boundary ===
/instance/
!/instance.example/

# === Legacy paths ===
/theke/
/archive/
nous/*/
shared/memory/
shared/contracts/
shared/checkpoints/
shared/status/
shared/insights/
shared/task-contracts/
shared/USER.md
data/
# Rust crate source directories named 'data' are source code, not runtime data
!crates/*/src/data/
!crates/*/src/data/**
!crates/mneme/src/engine/data/
!crates/mneme/src/engine/data/**
# Pinned upstream snapshot for the krites verbatim-drift metric (wave 0.3) —
# also source code, not runtime data.
!crates/krites/upstream-snapshot/cozo-core-src/data/
!crates/krites/upstream-snapshot/cozo-core-src/data/**
# Seed eval datasets are part of the shipped example instance
!instance.example/data/
!instance.example/data/**
# koina's model seed is compiled in via include_str! and validated by its
# build script, so it must survive any gitignore-filtered copy of the tree.
!crates/koina/data/
!crates/koina/data/**

# === Cargo build output ===
/target/
tui/target/
fuzz/target/
fuzz/artifacts/
# WHY fuzz/Cargo.lock is NOT ignored: it is committed so the fuzz targets build
# reproducibly under --locked. The rule ignoring it was left in place after the
# file was force-added, which made it invisible to every tool that walks by
# gitignore rather than by the index.
.cargo/*
# cargo-mutants local runs; baseline reports live on release branches only.
mutants.out/
mutants-out/
# Keep cargo-audit config under version control so CI and local runs share the same
# advisory-ignore list (mirrors deny.toml's [[advisories.ignore]]).
!.cargo/audit.toml

# === Model caches ===
.fastembed_cache/

# === Secrets ===
*.env
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/secrets*
**/*.key
**/*.pem
**/api-key

# === OS ===
.DS_Store
Thumbs.db

# === Syncthing ===
.stfolder/
.stignore
.stversions/

# === Workspace backups ===
*.aletheia-backup
*.bak
*.pre-compile.bak

# === Legacy ===
clawd

# === Financial data ===
**/*relay*.csv
**/*transaction*.csv

# === Large/binary ===
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.mp3
*.mp4
*.zip
*.tar.gz

# === Ephemeral state ===
.planning/
**/.task/
**/.taskrc
**/cookies.txt
**/heartbeat-state.json
*sync-conflict*

# === External MCP server state (see docs/MCP-SERVERS.md) ===
.serena/

# === Learned skills (instance-specific, not shipped) ===
shared/skills/
!shared/skills/_examples/

# === Cache/logs ===
shared/cache/
shared/blackboard/
shared/traces/
shared/logs/

# === Config with tokens ===
nous/*/config/
shared/competence/model.json
shared/config/tools.yaml
shared/prosoche/activity_model.json

# === Deploy backups ===
.deploy-backup/

# === Nix ===
/result
.direnv/

# === Build artifacts / virtual environments ===
.venv/
node_modules/
__pycache__/
*.egg-info/
**/dist/
!crates/*/dist/
.claude/
crates/aletheia/instance/
crates/theatron/desktop/target/

# === SBOM artifacts (generated during build) ===
bom.cdx.json
*.cdx.json
instance.example/eval/datasets/
target/
*.swp

# Dispatch worker artifacts (written into worktrees by the kanon dispatch harness)
.dispatch-prompt.md
.dispatch.err
.dispatch*

# Kanon substrate — runtime fjall key-value store; never source
.kanon/substrate/

# Dispatch-agent runtime artifacts — accidentally committed via #4401/#4408.
# Out-of-tree dispatch build dir + per-vendor agent stdout logs; never source.
target-local/
.kimi.log
.codex.log
.claude.log

# Generated _llm tiers — L3 API index + manifest regenerate per source change
# (manifest.toml was a rebase-conflict magnet). Materialize with:
#   uv run scripts/llm-extract-l3.py
# Hand-authored L1/L2/legacy tiers stay committed.
_llm/L3-api-index/
_llm/manifest.toml

# WHY: gate-attestation.yml's "Check release feature policy" step writes
# `cargo metadata` to this path at the repo root. On an ephemeral CI runner that
# is invisible; running the same step locally via scripts/run-gate-coverage.py
# leaves it in the working tree, where it reads as an untracked file worth
# committing. It is a build artifact of a check, not a source file.
/metadata.json
