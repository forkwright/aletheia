{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "simple",
    "include-component-in-tag": false,
    "draft": true,
    "force-tag-creation": true,
    "bump-minor-pre-major": true,
    "bump-patch-for-minor-pre-major": false,
    "changelog-sections": [
        {"type": "feat", "section": "Features"},
        {"type": "fix", "section": "Bug Fixes"},
        {"type": "perf", "section": "Performance"},
        {"type": "refactor", "section": "Refactoring", "hidden": true},
        {"type": "docs", "section": "Documentation"},
        {"type": "test", "section": "Testing", "hidden": true},
        {"type": "chore", "section": "Maintenance", "hidden": true},
        {"type": "ci", "hidden": true},
        {"type": "style", "hidden": true}
    ],
    "packages": {
        ".": {
            "changelog-path": "CHANGELOG.md",
            "extra-files": [
                {
                    "type": "toml",
                    "path": "Cargo.toml",
                    "jsonpath": "$.workspace.package.version"
                },
                {
                    "type": "toml",
                    "path": "Cargo.lock",
                    "jsonpath": "$.package[?(!@.source)].version"
                },
                {
                    "type": "toml",
                    "path": "fuzz/Cargo.lock",
                    "jsonpath": "$.package[?(@.name.value == 'eidos')].version"
                },
                {
                    "type": "toml",
                    "path": "fuzz/Cargo.lock",
                    "jsonpath": "$.package[?(@.name.value == 'hermeneus')].version"
                },
                {
                    "type": "toml",
                    "path": "fuzz/Cargo.lock",
                    "jsonpath": "$.package[?(@.name.value == 'koina')].version"
                },
                {
                    "type": "toml",
                    "path": "fuzz/Cargo.lock",
                    "jsonpath": "$.package[?(@.name.value == 'mneme')].version"
                },
                {
                    "type": "toml",
                    "path": "fuzz/Cargo.lock",
                    "jsonpath": "$.package[?(@.name.value == 'nous')].version"
                },
                {
                    "type": "toml",
                    "path": "fuzz/Cargo.lock",
                    "jsonpath": "$.package[?(@.name.value == 'taxis')].version"
                },
                {
                    "type": "toml",
                    "path": "_llm/current_state.toml",
                    "jsonpath": "$.state.version"
                }
            ]
        }
    }
}
