#!/usr/bin/env bash
# Pre-push hook: catch the CI-required checks that reliably slip to CI — cargo
# fmt, _llm index freshness, and clippy — at the push->PR boundary instead.
#
# Install: `git config core.hooksPath scripts/githooks` (auto-set by .envrc, or
# run `scripts/install-hooks.sh`). Deliberate bypass: `git push --no-verify`.
#
# Speed: fmt (~4s) + _llm (~3s) + gate-coverage (~5s) always run (cheap, and fmt
# is the check that first-failed CI on formatting alone). Clippy runs on
# AFFECTED crates by default; set PREPUSH_FULL=1 for the bit-exact workspace
# clippy CI runs, or PREPUSH_NO_CLIPPY=1 to skip it (CI gate-attestation is the
# backstop).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { echo "" >&2; echo "❌ pre-push: $1" >&2; echo "   (bypass with: git push --no-verify)" >&2; exit 1; }

run_llm_freshness() {
  echo "pre-push: regenerating _llm L3 index (generated, not committed) ..."
  uv run scripts/llm-extract-l3.py >/dev/null 2>&1 || fail "_llm extractor failed to run"
}

run_workspace_clippy() {
  echo "pre-push: cargo clippy (CI-exact workspace) ..."
  cargo +1.94.0 clippy --workspace --all-targets -- -D warnings \
    || fail "clippy (workspace) — fix the warnings above"
}

echo "pre-push: cargo fmt --check ..."
cargo +1.94.0 fmt --all -- --check \
  || fail "formatting — run 'cargo +1.94.0 fmt --all' then re-push"

# WHY before clippy: these 13 checks feed the required `gate` context, are pure
# python/shell, and finish in seconds -- so a regenerated-artifact miss should
# stop the push before the multi-minute compile, not after it. The step list is
# derived from the workflow, so this cannot drift from what CI will run.
echo "pre-push: gate-coverage-scripts (derived from the workflow) ..."
scripts/run-gate-coverage.py \
  || fail "gate-coverage-scripts — see the failures above"

# WHY: range vs the upstream the push targets; fall back to origin/main.
range="origin/main...HEAD"
git rev-parse --verify --quiet "@{push}" >/dev/null 2>&1 && range="@{push}..HEAD"
scope_detection_failed=0
changed=""
if ! changed="$(git diff --name-only "$range")"; then
  echo "pre-push: unable to determine changed files for '${range}'; running full scope checks" >&2
  scope_detection_failed=1
fi

# _llm L3 index — generated (gitignored), not committed. Regenerate locally so
# the dev's own _llm/ stays fresh for browsing; the extractor running cleanly is
# the only gate (a broken extractor fails the push), there is no committed diff.
if [ "$scope_detection_failed" = "1" ]; then
  run_llm_freshness
elif printf '%s\n' "$changed" | grep -qE '^crates/.*\.rs$|(^|/)Cargo\.toml$|^scripts/llm-extract-l3\.py$'; then
  run_llm_freshness
elif [ -z "$changed" ]; then
  echo "pre-push: no changed files detected for ${range}; _llm freshness skipped intentionally"
fi

if [ "${PREPUSH_NO_CLIPPY:-0}" = "1" ]; then
  echo "pre-push: clippy skipped (PREPUSH_NO_CLIPPY=1); CI gate-attestation is the backstop"
elif [ "${PREPUSH_FULL:-0}" = "1" ] || [ "$scope_detection_failed" = "1" ]; then
  run_workspace_clippy
else
  if ! pkgs="$(printf '%s\n' "$changed" | python3 scripts/affected-crates.py)"; then
    echo "pre-push: affected-crates scope detection failed; running full workspace clippy" >&2
    run_workspace_clippy
  else
    args=()
    pkg_names=()
    while IFS= read -r p; do
      [ -z "$p" ] && continue
      args+=("-p" "$p")
      pkg_names+=("$p")
    done <<< "$pkgs"

    if [ "${#pkg_names[@]}" -gt 0 ]; then
      echo "pre-push: cargo clippy on affected crates (${pkg_names[*]})..."
      # WHY: affected-crate clippy is a fast 95% pre-filter; CI runs the bit-exact
      # --workspace pass. Use PREPUSH_FULL=1 for parity.
      cargo +1.94.0 clippy "${args[@]}" --all-targets -- -D warnings \
        || fail "clippy (affected crates) — fix the warnings above"
    elif [ -z "$changed" ]; then
      echo "pre-push: no changed files detected for ${range}; clippy skipped intentionally"
    else
      echo "pre-push: no affected workspace crates detected; clippy skipped intentionally"
    fi
  fi
fi

echo "✅ pre-push checks passed"
